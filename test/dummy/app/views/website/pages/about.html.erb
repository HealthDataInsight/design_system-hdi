<section class="hdi-section">
  <div class="hdi-section__inner hdi-prose-measure">
    <%= ds_fixed_elements do |ds|
      ds.breadcrumb('Home', website_root_path)
      ds.breadcrumb('About', website_about_path)
      ds.main_heading 'About HDI'
    end %>

    <%= ds_paragraph 'We are a community interest company, and that is the point rather than a footnote. We exist to deliver for patients and the NHS, and what we earn goes back into doing that.' %>
    <%= ds_paragraph 'Jem Rashbass and Hilary Wilderspin founded HDI in 2011 to make sure that innovative work with the most personal of health data was done ethically, and for the direct benefit of patients.' %>
    <%= ds_paragraph 'Two principles have run through everything since: do the right thing, and get the job done quickly.' %>
    <%= ds_action_link 'Talk to us', website_contact_path %>
  </div>
</section>
