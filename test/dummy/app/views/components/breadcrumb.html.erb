<%=
ds_fixed_elements do |ds|
  ds.main_heading 'Breadcrumb', caption: 'Navigation'

  ds.breadcrumb('Home', root_path)
  ds.breadcrumb('Components', components_path)
  ds.breadcrumb('A Super Long Breadcrumb Name That Should Be Truncated', component_path('breadcrumb'))

  ds.lead_paragraph 'Use breadcrumbs to help users understand where they are in the service. Long labels are truncated with an ellipsis.'
end
%>

