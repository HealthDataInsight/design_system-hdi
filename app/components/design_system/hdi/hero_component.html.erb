<section class="<%= hero_classes %>"<% if hero_style %> style="<%= hero_style %>"<% end %>>
  <div class="hdi-section__inner">
    <% if image_hero? %>
      <div class="hdi-hero__content">
        <%= content %>
        <%= render DesignSystem::Hdi::HeadingComponent.new(title, level: 1) %>
        <% if lede.present? %>
          <p class="hdi-hero__lede hdi-body-l"><%= lede %></p>
        <% end %>
        <% if primary.present? || secondary.present? %>
          <div class="hdi-button-row">
            <% if primary.present? %>
              <%= helpers.ds_link_to primary[:label], primary[:href], type: :button %>
            <% end %>
            <% if secondary.present? %>
              <%= helpers.ds_link_to secondary[:label], secondary[:href], type: :secondary_button %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="hdi-hero__grid">
        <div>
          <%= content %>
          <%= render DesignSystem::Hdi::HeadingComponent.new(title, level: 1) %>
          <% if lede.present? %>
            <p class="hdi-hero__lede hdi-body-l"><%= lede %></p>
          <% end %>
          <% if primary.present? || secondary.present? %>
            <div class="hdi-button-row">
              <% if primary.present? %>
                <%= helpers.ds_link_to primary[:label], primary[:href], type: :button %>
              <% end %>
              <% if secondary.present? %>
                <%= helpers.ds_link_to secondary[:label], secondary[:href], type: :secondary_button %>
              <% end %>
            </div>
          <% end %>
        </div>
        <div>
          <%= render DesignSystem::Hdi::MediaPlaceholderComponent.new(label: media_label) %>
        </div>
      </div>
    <% end %>
  </div>
</section>
