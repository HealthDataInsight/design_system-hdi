<% content_for :body do %>
  <!--
    This example requires updating your template:

    ```
    <html class="h-full bg-white">
    <body class="h-full">
    ```
  -->
  <div data-controller="sidebar" class="flex-1 flex flex-col">
    <!-- Off-canvas menu for mobile, show/hide based on off-canvas menu state. -->
    <div data-sidebar-target="menu" class="sidebar-off-canvas-container hidden opacity-0" role="dialog" aria-modal="true">
      <!--
        Off-canvas menu backdrop, show/hide based on off-canvas menu state.

        Entering: "transition-opacity ease-linear duration-300"
          From: "opacity-0"
          To: "opacity-100"
        Leaving: "transition-opacity ease-linear duration-300"
          From: "opacity-100"
          To: "opacity-0"
      -->
      <div class="sidebar-off-canvas-backdrop"></div>

      <div class="sidebar-off-canvas">
        <!--
          Off-canvas menu, show/hide based on off-canvas menu state.

          Entering: "transition ease-in-out duration-300 transform"
            From: "-translate-x-full"
            To: "translate-x-0"
          Leaving: "transition ease-in-out duration-300 transform"
            From: "translate-x-0"
            To: "-translate-x-full"
        -->
        <div class="sidebar-off-canvas-inner">
          <!--
            Close button, show/hide based on off-canvas menu state.

            Entering: "ease-in-out duration-300"
              From: "opacity-0"
              To: "opacity-100"
            Leaving: "ease-in-out duration-300"
              From: "opacity-100"
              To: "opacity-0"
          -->
          <div class="sidebar-off-canvas-close-button-container">
            <button data-action="sidebar#hide" type="button" class="sidebar-off-canvas-close-button">
              <span class="sr-only">Close sidebar</span>
              <svg class="heroicon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Sidebar component, swap this element with another sidebar if you like -->
          <div class="sidebar">
            <div class="sidebar-header">
              <a href="<%= main_app.root_path %>" aria-label="Health Data Insight home"><img class="sidebar-logo" src="/design_system/static/hdi-frontend-0.12.0/logos/health-data-insight-logo.png" alt=""></a>
            </div>
            <div class="hdi-search-sidebar">
              <%= render 'hdi/searchbar' %>
            </div>
            <nav class="sidebar-content">
              <ul role="list" class="sidebar-list">
                <%= render 'hdi/navigation' %>
              </ul>
            </nav>
          </div>
        </div>
      </div>
    </div>

    <!-- Static sidebar for desktop -->
    <div class="sidebar-container relative z-40">
      <!-- Sidebar component, swap this element with another sidebar if you like -->
      <div class="sidebar">
        <div class="sidebar-header">
          <a href="<%= main_app.root_path %>" aria-label="Health Data Insight home"><img class="sidebar-logo" src="/design_system/static/hdi-frontend-0.12.0/logos/health-data-insight-logo.png" alt=""></a>
        </div>
        <div class="hdi-search-sidebar">
          <%= render 'hdi/searchbar' %>
        </div>
        <nav class="sidebar-content">
          <ul role="list" class="sidebar-list">

            <%= render 'hdi/navigation' %>

            <li class="sidebar-user-info">
              <%#= render 'signed_in_user_info' %>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="banner">
      <button type="button" data-action="sidebar#show" class="banner-menu-button">
        <span class="sr-only">Open sidebar</span>
        <svg class="heroicon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
      <div class="banner-title">HDI Portal</div>
      <div class="hdi-search-banner">
        <%= render 'hdi/searchbar' %>
      </div>
      <a href="#">
        <span class="sr-only">Your profile</span>
        <%#= current_user_image_tag %>
      </a>
    </div>

    <div class='hdi-width-container'>
      <main class='hdi-main-wrapper'>
        <%= yield :breadcrumbs %>
        <%= yield :backlink %>

        <%= render 'layouts/alert_and_notice' %>

        <%= yield %>
      </main>
    </div>

    <aside class="secondary-column">
      <!-- Secondary column (hidden on smaller screens) -->
    </aside>
  </div>

  <footer role="contentinfo" class="relative z-30">
    <div class="hdi-footer-container">
      <div class="hdi-width-container">
        <h2 class="hdi-visually-hidden">Support links</h2>
        <div class="hdi-footer">
          <ul class="hdi-footer__list">
            <% if controller.footer_links.present? %>
              <% controller.footer_links.each do |link| %>
                <li class="hdi-footer__list-item">
                  <%= link_to link[:name],
                      link[:href],
                      { class: "hdi-footer__list-item-link" }.merge(link[:options] || {}) %>
                </li>
              <% end %>
            <% end %>
          </ul>
          <div>
            <p class="hdi-footer__copyright">
              <% if controller.copyright_notice.present? %>
                <%= controller.copyright_notice %>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </footer>
<% end %>

<%= render template: 'layouts/hdi/full_page' %>
