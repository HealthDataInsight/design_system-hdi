<% hdi_navigation_groups(controller.navigation_items).each do |group| %>
  <li>
    <% if group[:heading].present? %>
      <details class="sidebar-group" open>
        <summary class="sidebar-item"><%= hdi_navigation_icon(group[:icon]) %><%= group[:heading] %></summary>
        <ul role="list" class="sidebar-items">
          <% group[:items].each do |item| %>
            <li>
              <%= hdi_sidebar_navigation_svg(item) %>
            </li>
          <% end %>
        </ul>
      </details>
    <% else %>
      <ul role="list" class="sidebar-items">
        <% group[:items].each do |item| %>
          <li>
            <%= hdi_sidebar_navigation_svg(item) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </li>
<% end %>
